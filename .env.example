DATABASE_URL=postgresql+psycopg://procurement:procurement@localhost:5432/procurement
# Separate service, Purchasing Manager and Finance Manager credentials. Replace before deployment.
API_KEY=local-service-change-me
REVIEWER_API_KEY=local-reviewer-change-me
REVIEWER_NAME=Demo Human Reviewer
FINANCE_API_KEY=local-finance-change-me
FINANCE_REVIEWER_NAME=Demo Finance Manager
# Backend-only provider secret. Set it in Render/Supabase/local environment; never in Vite variables.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
SUPABASE_URL=
SUPABASE_AUDIENCE=authenticated
ALLOW_API_KEYS=false
METRICS_ENABLED=true
